{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Isomorphic",
  "description": "A team knowledge base in a GitHub repository that Claude can search, read, edit, and render over MCP.",
  "colors": {
    "primary": "#0f172a",
    "light": "#e2e8f0",
    "dark": "#0f172a"
  },
  "fonts": {
    "heading": {
      "family": "Playfair Display",
      "weight": 600
    },
    "body": {
      "family": "Montserrat"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://isomorphic.sh"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "getting-started"
        ]
      },
      {
        "group": "Using your brain",
        "pages": [
          "writing-a-brain",
          "the-app",
          "computed-views",
          "custom-tools",
          "importing-records"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "tools",
          "permissions"
        ]
      },
      {
        "group": "Running it",
        "pages": [
          "self-hosting",
          "architecture"
        ]
      },
      {
        "group": "Project",
        "pages": [
          "building-with-claude",
          "licensing"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Source",
        "href": "https://github.com/isomorphic-team/isomorphic-app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Add the connector",
      "href": "/getting-started#connect-it-to-claude"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/isomorphic-team/isomorphic-app",
      "website": "https://isomorphic.sh"
    }
  }
}
